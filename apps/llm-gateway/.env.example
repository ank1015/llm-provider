# Supply through your shell/process manager; this file is not loaded automatically.
DATABASE_URL=postgresql://gateway:replace-me@localhost:5432/llm_gateway
# Generate each independently: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
ADMIN_API_KEY=replace-with-a-random-admin-key
ENCRYPTION_KEY=replace-with-64-hex-characters-and-keep-stable
PORT=3000
REQUEST_RETENTION_DAYS=7
# Maximum simultaneous LLM jobs per worker process (1-128). Start low for large contexts.
WORKER_CONCURRENCY=1
# Additional operator-trusted provider origins, comma-separated. Defaults already allow each provider's official origin.
PROVIDER_ALLOWED_ORIGINS=
# Required for callback delivery; HTTPS origins only. Empty means no callbacks are allowed.
WEBHOOK_ALLOWED_ORIGINS=
